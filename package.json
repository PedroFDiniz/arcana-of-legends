{
  "name": "just-another-rpg-game",
  "version": "0.2.0",
  "description": "A backend server supporting an online RPG game",
  "main": "index.js",
  "scripts": {
    "start": "set NODE_ENV=DEVELOPMENT && npx tsc && node ./dist/index.js",
    "start:linux": "NODE_ENV=DEVELOPMENT && npx tsc && node ./dist/index.js",
    "test": "jest",
    "deploy:build": "npm i . && npx tsc",
    "deploy:run": "NODE_ENV=PRODUCTION node ./dist/index.js"
  },
  "author": "Pedro Falcão",
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^30.1.2",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "mongodb-memory-server": "10.2.1",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "1.19.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.5.2",
    "@types/nodemailer": "7.0.1",
    "bcrypt": "6.0.0",
    "body-parser": "2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "just-another-rpg-game": "file:",
    "mongoose": "8.18.1",
    "nodemailer": "^7.0.6",
    "typescript": "5.9.2"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E  HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        2,
        "never",
        [
          "start-case",
          "pascal-case"
        ]
      ]
    }
  }
}
